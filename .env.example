# Copia este archivo como .env y rellena tus propios valores (nuevos, no reutilices los de bot-nevera)
SECRET_KEY=genera-una-clave-secreta-nueva-aqui

# Déjalo comentado para usar SQLite local por defecto (instance/store.db).
# DATABASE_URL=sqlite:////ruta/absoluta/a/instance/store.db

# Opcional: si la rellenas, la pestaña "Escanear pedido" reconocera las fundas automaticamente con IA
# Consiguela en https://console.anthropic.com/settings/keys (crea una key NUEVA para este proyecto)
ANTHROPIC_API_KEY=

FLASK_ENV=development
